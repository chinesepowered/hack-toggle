# Copy to .env and fill in. .env is git-ignored.

# The model that powers the AI guests, behind an OpenAI-compatible chat
# completions endpoint. It must accept temperature, max_tokens and
# response_format {"type": "json_object"}. The experiment in this repository
# used Qwen/Qwen3.8-27B at https://api.inference.wandb.ai/v1.
# A run of 120 guests uses a little over 4 million tokens.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# The date the booking site treats as "today" (YYYY-MM-DD). Fixing it means a
# rerun sees the same calendar and the same sold-out times. Remove to use the real date.
ONSEN_TODAY=2026-11-27

# Only needed to rebuild the demo video's voice-over (video/build.mjs).
ELEVENLABS_API_KEY=
