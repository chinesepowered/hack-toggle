# Copy to .env and fill in. .env is git-ignored.

# The model that powers the AI guests. Any OpenAI-compatible chat completions
# endpoint works: OpenAI, a hosted open model, or a local server.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# The date the booking site treats as "today" (YYYY-MM-DD). Fixing it means a
# rerun sees the same calendar and the same sold-out times. Remove to use the real date.
ONSEN_TODAY=2026-11-27

# Only needed to rebuild the demo video's voice-over (video/build.mjs).
ELEVENLABS_API_KEY=
