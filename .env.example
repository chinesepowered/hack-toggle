# Copy to .env and fill in. .env is git-ignored.

# The model that powers the AI guests. Any OpenAI-compatible chat completions
# endpoint works: OpenAI, a hosted open model, or a local server.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Only needed to rebuild the demo video's voice-over (video/build.mjs).
ELEVENLABS_API_KEY=
